---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  altLangHref?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = 'Operator and builder working on brain health, practical products, and human systems. Based in Cartagena, Colombia.',
  lang = 'en',
  altLangHref = lang === 'en' ? '/es' : '/',
  ogType = 'website',
  publishedTime,
} = Astro.props;

const SITE = 'https://yatan.co';
const AUTHOR = 'Yatan Blumenthal Vargas';
const FONTS_URL = 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap';

// Cloudflare Pages 308-redirects /foo to /foo/, so absolute URLs always carry the trailing slash.
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const pathname = withSlash(Astro.url.pathname);
const canonical = `${SITE}${pathname}`;
const isHome = pathname === '/' || pathname === '/es/';

// Only emit hreflang for real translation pairs; fallbacks to the other homepage aren't translations.
const hasTranslation = isHome || altLangHref.includes('/writing/');
const enHref = `${SITE}${lang === 'en' ? pathname : withSlash(altLangHref)}`;
const esHref = `${SITE}${lang === 'es' ? pathname : withSlash(altLangHref)}`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/#person`,
  name: AUTHOR,
  url: SITE,
  jobTitle: 'Operator and Builder',
  sameAs: [
    'https://github.com/yatanco',
    'https://linkedin.com/in/yatanblumenthal',
    'https://x.com/yatanco',
    'https://instagram.com/yatan.co',
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={AUTHOR} href={lang === 'es' ? '/es/rss.xml' : '/rss.xml'} />
    {hasTranslation && (
      <>
        <link rel="alternate" hreflang="en" href={enHref} />
        <link rel="alternate" hreflang="es" href={esHref} />
        <link rel="alternate" hreflang="x-default" href={enHref} />
      </>
    )}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={AUTHOR} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@yatanco" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONTS_URL} />
    <link rel="stylesheet" href={FONTS_URL} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS_URL} /></noscript>

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
    <slot name="head" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C4MCQHJQY0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-C4MCQHJQY0');
    </script>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="shell-nav">
        <a class="shell-home" href="/">Yatan Blumenthal Vargas</a>
        <div class="shell-controls">
          <nav aria-label="Main navigation">
            <a href="/">Now</a>
            <span class="sep">/</span>
            <a href="/writing">Writing</a>
          </nav>
          <div class="lang-toggle">
            {lang === 'en' ? (
              <>
                <span class="lang-current" role="img" aria-label="English">🇺🇸</span>
                <span class="lang-sep">·</span>
                <a href={altLangHref} hreflang="es"><span role="img" aria-label="Español">🇨🇴</span></a>
              </>
            ) : (
              <>
                <a href={altLangHref} hreflang="en"><span role="img" aria-label="English">🇺🇸</span></a>
                <span class="lang-sep">·</span>
                <span class="lang-current" role="img" aria-label="Español">🇨🇴</span>
              </>
            )}
          </div>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle color theme">☾</button>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="shell-footer" aria-label="Social links">
        <a href="https://github.com/yatanco">GitHub</a>
        <span class="sep">·</span>
        <a href="https://linkedin.com/in/yatanblumenthal">LinkedIn</a>
        <span class="sep">·</span>
        <a href="https://instagram.com/yatan.co">Instagram</a>
        <span class="sep">·</span>
        <a href="https://x.com/yatanco">X</a>
      </footer>
    </div>
    <script>
      const btn = document.querySelector('[data-theme-toggle]');
      const label = (theme) => (theme === 'light' ? '☀' : '☾');
      const describe = (theme) => (theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');

      function sync() {
        const theme = document.documentElement.getAttribute('data-theme') || 'dark';
        btn.textContent = label(theme);
        btn.setAttribute('aria-label', describe(theme));
      }
      sync();

      btn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        sync();
      });
    </script>
  </body>
</html>

<style>
  .shell {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .shell-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
    font-family: var(--mono);
  }

  .shell-home {
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .shell-home:hover { color: var(--mint); text-decoration: none; }

  .shell-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.9rem;
  }

  nav {
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  nav a { color: var(--text-dim); }
  nav a:hover { color: var(--mint); }

  .sep {
    color: var(--rule);
    margin: 0 0.35rem;
  }

  .lang-toggle {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--text-dim);
  }
  .lang-toggle a { color: var(--text-dim); }
  .lang-toggle a:hover { color: var(--mint); }
  .lang-current { opacity: 0.55; }
  .lang-sep {
    color: var(--rule);
    margin: 0 0.3rem;
  }

  .theme-toggle {
    background: none;
    border: none;
    padding: 0;
    line-height: 1;
    font-size: 1rem;
    color: var(--text-dim);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--mint); }

  .shell-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .shell-footer a { color: var(--text-dim); }
  .shell-footer a:hover { color: var(--mint); }

  @media (max-width: 700px) {
    .shell { padding: 2rem 1.25rem 3rem; }
  }
</style>
