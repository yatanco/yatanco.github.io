---
import { getCollection, render } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';
import { estimateReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ id, data }) => id.startsWith('en/') && !data.draft);
  const esSlugs = new Set(
    (await getCollection('writing', ({ id }) => id.startsWith('es/')))
      .map((post) => post.id.replace(/^es\//, ''))
  );

  return posts.map((post) => {
    const slug = post.id.replace(/^en\//, '');
    return {
      params: { slug },
      props: {
        post,
        slug,
        altLangHref: esSlugs.has(slug) ? `/es/writing/${slug}` : '/es',
      },
    };
  });
}

const { post, altLangHref } = Astro.props;
const { Content } = await render(post);
const readingTime = estimateReadingTime(post.body);
---
<EssayLayout
  title={post.data.title}
  date={post.data.date}
  description={post.data.description}
  tags={post.data.tags}
  lang="en"
  altLangHref={altLangHref}
  readingTime={readingTime}
>
  <Content />
</EssayLayout>
